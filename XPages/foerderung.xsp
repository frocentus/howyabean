<?xml version="1.0" encoding="UTF-8"?>
<xp:view xmlns:xp="http://www.ibm.com/xsp/core" xmlns:xc="http://www.ibm.com/xsp/custom">
	<xp:this.data>
		<xp:dominoDocument var="antrag" formName="FoerderAntrag" documentId="#{param.unid}" action="editDocument" />
	</xp:this.data>
	<xc:navbar />
	<xp:div id="uiContainer" styleClass="container">
		<div class="page-header">
			<h1>
				<xp:text value="#{antrag.applicant}" />
				<small><xp:text value="#{antrag.status}" /></small>
			</h1>
			<xp:link text="Zurück zur Liste" value="/foerderungen.xsp" />
		</div>

		<xp:panel rendered="#{!empty foerder.message}">
			<div class="alert alert-info"><xp:text value="#{foerder.message}" /></div>
		</xp:panel>

		<xp:form id="form1">
			<div class="row">
				<div class="col-md-6">
					<div class="panel panel-default">
						<div class="panel-heading">Antragsteller*in und Kind</div>
						<div class="panel-body">
							<div class="form-group">
								<label>Antragsteller*in</label>
								<xp:inputText value="#{antrag.applicant}" styleClass="form-control"
									readonly="#{foerder.role != 'Sachbearbeiter'}" />
							</div>
							<div class="form-group">
								<label>Kind</label>
								<xp:inputText value="#{antrag.child}" styleClass="form-control"
									readonly="#{foerder.role != 'Sachbearbeiter'}" />
							</div>
						</div>
					</div>

					<div class="panel panel-default">
						<div class="panel-heading">Schule und Veranstaltung</div>
						<div class="panel-body">
							<div class="form-group">
								<label>Bildungseinrichtung</label>
								<xp:inputText value="#{antrag.school}" styleClass="form-control"
									readonly="#{foerder.role != 'Sachbearbeiter'}" />
							</div>
							<div class="form-group">
								<label>Schulart</label>
								<xp:comboBox value="#{antrag.schoolType}" styleClass="form-control"
									disabled="#{foerder.role != 'Sachbearbeiter'}">
									<xp:selectItem itemLabel="Volksschule" itemValue="Volksschule" />
									<xp:selectItem itemLabel="Mittelschule" itemValue="Mittelschule" />
									<xp:selectItem itemLabel="Sonderschule" itemValue="Sonderschule" />
									<xp:selectItem itemLabel="Politechnische Schule" itemValue="Politechnische Schule" />
									<xp:selectItem itemLabel="Gymnasium (Unterstufe)" itemValue="Gymnasium (Unterstufe)" />
								</xp:comboBox>
							</div>
							<div class="form-group">
								<label>Schulstufe</label>
								<xp:inputText value="#{antrag.level}" styleClass="form-control"
									readonly="#{foerder.role != 'Sachbearbeiter'}">
									<xp:this.converter>
										<xp:convertNumber type="number" integerOnly="true" />
									</xp:this.converter>
								</xp:inputText>
							</div>
							<div class="form-group">
								<label>Veranstaltung</label>
								<xp:radioGroup value="#{antrag.winter}" disabled="#{foerder.role != 'Sachbearbeiter'}">
									<xp:selectItem itemLabel="Wintersport" itemValue="1" />
									<xp:selectItem itemLabel="Sonstiges" itemValue="0" />
								</xp:radioGroup>
							</div>
							<div class="form-group">
								<label>Kosten (EUR)</label>
								<xp:inputText value="#{antrag.costs}" styleClass="form-control"
									readonly="#{foerder.role != 'Sachbearbeiter'}">
									<xp:this.converter>
										<xp:convertNumber type="number" />
									</xp:this.converter>
								</xp:inputText>
							</div>
						</div>
					</div>
				</div>

				<div class="col-md-6">
					<div class="panel panel-default">
						<div class="panel-heading">Haushalt und Einkommen</div>
						<div class="panel-body">
							<div class="form-group">
								<label>Netto-Haushaltseinkommen (EUR)</label>
								<xp:inputText value="#{antrag.income}" styleClass="form-control"
									readonly="#{foerder.role != 'Sachbearbeiter'}">
									<xp:this.converter>
										<xp:convertNumber type="number" />
									</xp:this.converter>
								</xp:inputText>
							</div>
							<div class="form-group">
								<label>Erwachsene im Haushalt</label>
								<xp:inputText value="#{antrag.adults}" styleClass="form-control"
									readonly="#{foerder.role != 'Sachbearbeiter'}">
									<xp:this.converter>
										<xp:convertNumber type="number" integerOnly="true" />
									</xp:this.converter>
								</xp:inputText>
							</div>
							<div class="form-group">
								<label>Kinder im Haushalt</label>
								<xp:inputText value="#{antrag.children}" styleClass="form-control"
									readonly="#{foerder.role != 'Sachbearbeiter'}">
									<xp:this.converter>
										<xp:convertNumber type="number" integerOnly="true" />
									</xp:this.converter>
								</xp:inputText>
							</div>
							<div class="form-group">
								<label>Mehrling, Geschwister nehmen teil</label>
								<xp:radioGroup value="#{antrag.multiple}" disabled="#{foerder.role != 'Sachbearbeiter'}">
									<xp:selectItem itemLabel="Ja" itemValue="1" />
									<xp:selectItem itemLabel="Nein" itemValue="0" />
								</xp:radioGroup>
							</div>
							<div class="form-group">
								<label>Vermerk / Kommentar des Sachbearbeiters</label>
								<xp:inputTextarea value="#{antrag.comment}" rows="4" styleClass="form-control"
									readonly="#{foerder.role != 'Sachbearbeiter'}" />
							</div>
						</div>
					</div>

					<div class="panel panel-default">
						<div class="panel-heading">Beilagen</div>
						<div class="panel-body">
							<xp:panel rendered="#{foerder.role == 'Sachbearbeiter'}">
								<xp:fileDownload value="#{antrag.document}" allowDelete="true" />
							</xp:panel>
							<xp:panel rendered="#{foerder.role != 'Sachbearbeiter'}">
								<xp:fileDownload value="#{antrag.document}" allowDelete="false" />
							</xp:panel>
							<xp:panel rendered="#{foerder.role == 'Sachbearbeiter'}">
								<div class="form-group" style="margin-top: 10px;">
									<label>Beilage hinzufügen</label>
									<xp:fileUpload id="upload" value="#{antrag.document}" />
								</div>
							</xp:panel>
						</div>
					</div>
				</div>
			</div>

			<xp:panel rendered="#{foerder.role == 'Sachbearbeiter'}">
				<xp:button value="Speichern" id="save" styleClass="btn btn-success">
					<xp:eventHandler event="onclick" submit="true" refreshMode="complete"
						action="#{javascript:var ok = antrag.save(); foerder.updateDerived(param.unid); foerder.setMessage(ok ? 'Antrag gespeichert.' : 'Speichern fehlgeschlagen.');}" />
				</xp:button>
			</xp:panel>
		</xp:form>
	</xp:div>
</xp:view>
